+- * effects = remember(...) { { if (glassBlurEnabled()) { blur(...); lens(...) } } }
++ * effects = remember(...) {
++ *     {
++ *         val f = glassPerfFactor()
++ *         if (f > 0.01f) { blur(blurPx * f); lens(r * f, s * f) }
++ *     }
