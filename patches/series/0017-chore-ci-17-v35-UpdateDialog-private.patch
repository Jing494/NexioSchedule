++            }
++        }
++        try {
++            return block()
++        } finally {
++            synchronized(bypassLock) {
++                bypassDepth--
++                if (bypassDepth <= 0) {
++                    bypassDepth = 0
++                    scheduleBypassClose(context)
++                }
++            }
++        }
++    }
